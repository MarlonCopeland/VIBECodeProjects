# UnjadedDigital — environment template
# Copy to `.env` and fill in. Only PUBLIC values belong here; never commit
# service-role keys or other secrets. `.env` is gitignored.

# ---- App identity -----------------------------------------------------------
APP_NAME=Legend
APP_SLUG=legend
APP_SCHEME=legend
APP_BUNDLE_ID=com.unjadeddigital.legend
APP_VERSION=0.1.0

# ---- Backend ----------------------------------------------------------------
# 'supabase' -> real accounts on the Legend Supabase project. THE DEFAULT for
#               all testing: sign in with the test accounts created by
#               `npm run seed:test-users` (see TESTING.md).
# 'local'    -> offline demo backend (demo@unjadeddigital.com / Password1).
#               Troubleshooting only — e.g. to tell "toolchain broken?" apart
#               from "backend misconfigured?". Don't use it for normal testing.
APP_BACKEND=supabase

# ---- Supabase (Project Settings -> API) ------------------------------------
# The live Legend project. Both values are public by design (the anon key is
# also in eas.json); RLS is what protects the data.
SUPABASE_URL=https://krxszvviuqlzxxcvhyss.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtyeHN6dnZpdXFsenh4Y3ZoeXNzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU3OTI1MTEsImV4cCI6MjEwMTM2ODUxMX0.FmqEiEN298JZpIdero8vlZrEZ2sQj_zrGlR5ABEYLls

# ---- Web / deep links -------------------------------------------------------
WEB_BASE_URL=

# ---- OAuth providers --------------------------------------------------------
AUTH_GOOGLE_ENABLED=true
AUTH_APPLE_ENABLED=true

# ---- Payments (Stripe — publishable + price IDs only) ----------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_TIER1=
STRIPE_PRICE_TIER2=

# ---- Feature flags (turn whole modules on/off) -----------------------------
# `contacts` is core to Legend and always on.
FEATURE_PROFILE=true
FEATURE_SETTINGS=true
FEATURE_NOTIFICATIONS=true
FEATURE_PAYMENTS=false
FEATURE_CIRCLES=true
FEATURE_OUTREACH=true
# Sync (paid upgrade UI + oplog relay). Requires the Supabase backend.
FEATURE_SYNC=true
# Legend Full Suite — one-time IAP that emails the desktop download link.
# Requires the Supabase backend + the Edge Functions in supabase/functions.
FEATURE_FULL_SUITE=true
FULL_SUITE_PRODUCT_ID_IOS=com.unjadeddigital.legend.fullsuite
FULL_SUITE_PRODUCT_ID_ANDROID=full_suite

# ---- EAS --------------------------------------------------------------------
EAS_PROJECT_ID=

# ---- Premium palette store UI ----------------------------------------------
# Shows $ prices + Unlock buttons on Settings -> Rarity colors. Keep ON for
# dev/internal TestFlight; eas.json forces it OFF for external/release builds
# until real StoreKit IAP exists (Apple Guideline 3.1.1).
FEATURE_PALETTE_STORE=true
