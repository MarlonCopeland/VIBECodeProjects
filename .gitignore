# VIBES monorepo — several Expo/React Native apps live side by side, so all
# patterns are unanchored to cover every app directory.

# Dependencies
node_modules/
yarn-error.log*

# Environment (keys/secrets — each app ships a .env.example instead)
.env

# Expo / Metro build artifacts
.expo/
dist/
metro-cache/
web-build/

# Native build output
ios/build/
android/app/build/
android/.gradle/
android/local.properties
android/.idea/
ios/Pods/

# Supabase CLI scratch
supabase/.temp/

# OS generated files
.DS_Store
Snapshots*

# Logs and temporary data
npm-debug.log*
*.swp

# Test coverage
coverage/
