# VIBES monorepo — several Expo/React Native apps live side by side, so all
# patterns are unanchored to cover every app directory.

# Dependencies
node_modules/
yarn-error.log*

# Environment (keys/secrets — each app ships a .env.example instead)
.env

# Expo / Metro build artifacts
.expo/
dist/
metro-cache/
web-build/

# Native build output
ios/build/
android/app/build/
android/.gradle/
android/local.properties
android/.idea/
ios/Pods/

# Supabase CLI scratch
supabase/.temp/

# OS generated files
.DS_Store

# NOTE: do not add a bare `Snapshots*` pattern here. Git matches ignore rules
# case-insensitively when core.ignorecase is true (the default on Windows and
# macOS), so it also swallows ordinary sources like `snapshots.ts` — which is
# invisible locally and only surfaces as a missing module in CI/EAS builds,
# because those build from the git archive rather than the working tree.
# Scope any future snapshot rule to its directory, e.g. `**/__snapshots__/`.

# Logs and temporary data
npm-debug.log*
*.swp

# Test coverage
coverage/
