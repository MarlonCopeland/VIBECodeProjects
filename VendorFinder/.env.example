# Vendor Finder — environment template
# Copy to `.env` and fill in. Only PUBLIC values belong here; never commit
# service-role keys or other secrets. `.env` is gitignored.

# ---- App identity -----------------------------------------------------------
APP_NAME=Vendor Finder
APP_SLUG=vendorfinder
APP_SCHEME=vendorfinder
APP_BUNDLE_ID=com.vendorfinder.app
APP_VERSION=1.0.0

# ---- Backend ----------------------------------------------------------------
# 'local'    -> in-memory demo backend (no network). Great for first run.
# 'supabase' -> real Supabase backend (requires the two values below).
APP_BACKEND=local

# ---- Supabase (Project Settings -> API) ------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Web / deep links -------------------------------------------------------
WEB_BASE_URL=

# ---- OAuth providers --------------------------------------------------------
AUTH_GOOGLE_ENABLED=true
AUTH_APPLE_ENABLED=true

# ---- Payments (Stripe — publishable + price IDs only) ----------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_TIER1=
STRIPE_PRICE_TIER2=
STRIPE_PRICE_TIER3=

# ---- Feature flags (turn whole modules on/off) -----------------------------
# auth + vendors are core and always on.
FEATURE_FAVORITES=true
FEATURE_ALERTS=true
FEATURE_VENDOR_TOOLS=true
FEATURE_ADMIN=true
FEATURE_PROFILE=true
FEATURE_SETTINGS=true
FEATURE_NOTIFICATIONS=true
FEATURE_PAYMENTS=true

# ---- EAS --------------------------------------------------------------------
EAS_PROJECT_ID=
