# Copy to .env and fill in. NEVER commit .env (only PUBLIC keys are read on the
# client; service-role / Stripe secret keys live ONLY in Supabase Edge Function
# secrets, never here).

# Which backend the app uses: local | supabase
APP_BACKEND=local

# --- Supabase (public values; safe to ship in client) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Stripe (publishable key is public; price ids are not secret) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_TIER1=
STRIPE_PRICE_TIER2=
STRIPE_PRICE_TIER3=

# Deployed web/PWA base URL (Stripe Checkout success/cancel returns)
WEB_BASE_URL=http://localhost:19006

# EAS project id (filled by `eas init`)
EAS_PROJECT_ID=
