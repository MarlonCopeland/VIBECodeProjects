{
  "name": "unjaded-digital-template",
  "version": "1.0.0",
  "description": "UnjadedDigital — a modular, cross-platform Expo (React Native) app template with Supabase auth, account security, navigation, and profile management.",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=18 <=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^7.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.1",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.1",
    "expo-device": "~7.0.1",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.3",
    "expo-linking": "~7.0.3",
    "expo-notifications": "~0.29.9",
    "expo-router": "~4.0.11",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.4",
    "expo-web-browser": "~14.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "dotenv": "^16.4.5",
    "typescript": "~5.3.3"
  }
}
