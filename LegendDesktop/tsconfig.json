{
  // Renderer. Shared files under ../LegendNetworkingApp/src are type-checked
  // too (tsc follows the imports); `paths` points their Expo/RN imports at
  // the same shims vite.config.ts aliases, and their npm deps at THIS app's
  // node_modules, so this checks exactly what gets bundled.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@legend/*": ["../LegendNetworkingApp/src/*"],
      "react-native": ["./src/platform/shims/react-native.ts"],
      "expo-crypto": ["./src/platform/shims/expo-crypto.ts"],
      "expo-constants": ["./src/platform/shims/expo-constants.ts"],
      "expo-secure-store": ["./src/platform/shims/expo-secure-store.ts"],
      "expo-linking": ["./src/platform/shims/expo-linking.ts"],
      "expo-web-browser": ["./src/platform/shims/expo-web-browser.ts"],
      "expo-image-picker": ["./src/platform/shims/expo-image-picker.ts"],
      "expo-sqlite": ["./src/platform/shims/expo-sqlite.ts"],
      "@react-native-async-storage/async-storage": ["./src/platform/shims/async-storage.ts"],
      "react-native-url-polyfill/auto": ["./src/platform/shims/empty.ts"],
      "expo-contacts": ["./src/platform/shims/phone-only.ts"],
      "expo-document-picker": ["./src/platform/shims/phone-only.ts"],
      "expo-file-system/legacy": ["./src/platform/shims/phone-only.ts"],
      "expo-sharing": ["./src/platform/shims/phone-only.ts"],
      "expo-sms": ["./src/platform/shims/phone-only.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      "@noble/ciphers/*": ["./node_modules/@noble/ciphers/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/vite-env.d.ts"]
}
